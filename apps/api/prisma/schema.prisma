generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ParticipantGender {
  MALE
  FEMALE
}

enum ActivityMode {
  ROUND_ROBIN
  GROUP_KNOCKOUT
}

enum ActivityStatus {
  PUBLISHED
  CANCELED
}

enum SignupStatus {
  CONFIRMED
  WAITLISTED
}

enum MatchStage {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  FINAL
  THIRD_PLACE
}

enum MatchSide {
  A
  B
}

enum MatchScoreRecordStatus {
  PENDING
  COMPLETED
  UNPLAYED
}

enum MatchScoreConfirmationState {
  NONE
  NOT_REQUIRED
  PENDING_CONFIRM
  CONFIRMED
  DISPUTED
}

enum MatchScoreAuditAction {
  RECORD
  UPDATE
  MARK_UNPLAYED
  CONFIRM
  DISPUTE
  ARBITRATE
}

model User {
  id                 String             @id @default(cuid())
  email              String?            @unique
  name               String?
  phone              String?            @unique
  wechatOpenId       String?            @unique
  avatarUrl          String?
  gender             ParticipantGender?
  role               UserRole           @default(USER)
  profileCompletedAt DateTime?          @db.Timestamptz(3)

  activities   Activity[]
  signups      ActivitySignup[]
  sessions     UserSession[]
  scoreSubmissions ActivityMatch[]
  scoreAudits  ActivityMatchScoreAudit[]
  scoreConfirmations ActivityMatchScoreConfirmation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String   @unique
  wechatSessionKey String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Activity {
  id                  String            @id @default(cuid())
  title               String
  note                String?
  coverImageUrl       String?
  mode                ActivityMode
  status              ActivityStatus    @default(PUBLISHED)
  signupStartAt       DateTime          @db.Timestamptz(3)
  startAt             DateTime          @db.Timestamptz(3)
  endAt               DateTime          @db.Timestamptz(3)
  locationName        String
  locationAddress     String
  latitude            Float?
  longitude           Float?
  venue               String?
  maxPlayers          Int
  courtCount          Int
  warmupMinutes       Int               @default(10)
  matchRuleCode       String            @default("SIX_GAMES_6_TB")
  groupCount          Int?
  qualifyPerGroup     Int?
  enableThirdPlace    Boolean?
  schedulePublishedAt DateTime?         @db.Timestamptz(3)
  creatorId           String?
  creator             User?             @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  signups       ActivitySignup[]
  rounds        ActivityRound[]
  matches       ActivityMatch[]
  scoreAudits   ActivityMatchScoreAudit[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([startAt, createdAt])
  @@index([creatorId])
}

model ActivitySignup {
  id              String            @id @default(cuid())
  activityId      String
  activity        Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  participantName String
  gender          ParticipantGender?
  status          SignupStatus
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  playerAMatches ActivityMatch[] @relation("MatchPlayerA")
  playerBMatches ActivityMatch[] @relation("MatchPlayerB")
  wonMatches     ActivityMatch[] @relation("MatchWinner")

  @@unique([activityId, participantName])
  @@unique([activityId, userId])
  @@index([activityId, status, createdAt])
  @@index([userId])
}

model ActivityRound {
  id          String          @id @default(cuid())
  activityId  String
  activity    Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  roundNumber Int
  createdAt   DateTime        @default(now())

  matches ActivityMatch[]

  @@unique([activityId, roundNumber])
  @@index([activityId, roundNumber])
}

model ActivityMatch {
  id                  String                       @id @default(cuid())
  activityId          String
  activity            Activity                     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  roundId             String?
  round               ActivityRound?               @relation(fields: [roundId], references: [id], onDelete: Cascade)
  stage               MatchStage?
  groupNumber         Int?
  bracketSlot         Int?
  courtName           String?
  startAt             DateTime?                    @db.Timestamptz(3)
  endAt               DateTime?                    @db.Timestamptz(3)
  playerAId           String?
  playerA             ActivitySignup?              @relation("MatchPlayerA", fields: [playerAId], references: [id], onDelete: SetNull)
  playerBId           String?
  playerB             ActivitySignup?              @relation("MatchPlayerB", fields: [playerBId], references: [id], onDelete: SetNull)
  playerAGames        Int?
  playerBGames        Int?
  playerATiebreakPoints Int?
  playerBTiebreakPoints Int?
  winnerId            String?
  winner              ActivitySignup?              @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  scoreUpdatedAt      DateTime?
  scoreSubmittedById  String?
  scoreSubmittedBy    User?                        @relation(fields: [scoreSubmittedById], references: [id], onDelete: SetNull)
  scoreSubmittedSide  MatchSide?
  recordStatus        MatchScoreRecordStatus       @default(PENDING)
  confirmationState   MatchScoreConfirmationState  @default(NONE)
  createdAt           DateTime                     @default(now())

  scoreAudits     ActivityMatchScoreAudit[]
  scoreConfirmations ActivityMatchScoreConfirmation[]

  @@index([activityId])
  @@index([roundId, courtName])
  @@index([activityId, stage, bracketSlot])
  @@index([activityId, recordStatus])
}

model ActivityMatchScoreAudit {
  id             String                   @id @default(cuid())
  activityId     String
  activity       Activity                 @relation(fields: [activityId], references: [id], onDelete: Cascade)
  matchId        String
  match          ActivityMatch            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?                    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         MatchScoreAuditAction
  recordStatusBefore MatchScoreRecordStatus?
  recordStatusAfter  MatchScoreRecordStatus
  playerAGamesBefore  Int?
  playerBGamesBefore  Int?
  playerATiebreakPointsBefore Int?
  playerBTiebreakPointsBefore Int?
  playerAGamesAfter   Int?
  playerBGamesAfter   Int?
  playerATiebreakPointsAfter Int?
  playerBTiebreakPointsAfter Int?
  reason         String?
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)

  @@index([matchId, createdAt])
  @@index([activityId, createdAt])
}

model ActivityMatchScoreConfirmation {
  id             String       @id @default(cuid())
  matchId        String
  match          ActivityMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scoreUpdatedAt DateTime     @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([matchId, userId])
  @@index([userId, createdAt])
}